[Unit]
Description=TheJules telemetry relay to ESP32
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/thejules
ExecStart=/usr/bin/python3 /opt/thejules/collector/telemetry_relay.py --host 127.0.0.1 --port 18080 --target-url http://ESP32_IP
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

